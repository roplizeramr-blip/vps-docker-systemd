# Deployment environment for the Docker (systemd-as-PID-1) cloud desktop.
#
# Copy to .env and fill in the values, then set them as container env vars.
# NEVER commit the real .env file.

# Required: HTTP Basic-Auth password for the public URL (min 6 chars).
VNC_PW=

# Optional: Linux account password for the "desktop" user inside the system.
DESKTOP_PW=

# Optional: root password inside the system.
ROOT_PW=

# Optional: web user name (default: admin).
VNC_USER=admin

# Optional: desktop geometry (default: 1280x720).
VNC_RESOLUTION=1280x720

# Optional: public port the platform exposes (default: 3000).
PORT=3000

# Optional: hostname shown inside the desktop (default: docker-desktop).
DESKTOP_HOSTNAME=docker-desktop
